{
  "name": "reelkit",
  "private": true,
  "type": "module",
  "description": "Turn a product link or news story into a narrated 9:16 reel, rendered in code with real source media.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "doctor": "node scripts/doctor.mjs",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "reel": "node src/run.mjs",
    "pick": "node src/pick-news.mjs",
    "write": "node src/write-script.mjs",
    "validate": "node src/validate.mjs",
    "voice": "node src/tts.mjs",
    "mix": "node src/audio.mjs",
    "render": "node src/render.mjs",
    "serve": "node src/serve.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@resvg/resvg-js": "^2.6.2",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "kokoro-js": "^1.2.1",
    "lucide": "^1.52.0"
  }
}
